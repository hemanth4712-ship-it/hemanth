# Smart Dairy Farm Management System - Environment Configuration
# Copy this file to .env and configure your production values

PROJECT_NAME="Smart Dairy Farm Management System (గోకులం డైరీ)"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"

# Security (Generate a secure random string for production: `openssl rand -hex 32`)
SECRET_KEY="replace-this-with-a-random-32-byte-secret-key-for-jwt-tokens"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database URL
# Default SQLite for simple local zero-setup dev:
DATABASE_URL="sqlite:///./smart_dairy.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_dairy"

# AI Assistant Integration (Optional - System works completely offline using built-in farm telemetry engine)
# GEMINI_API_KEY="your-google-gemini-api-key-here"
